# Copy to .env.local and fill in. Everything here is optional: with no Sanity project
# configured the storefront serves its built-in sample content.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity (create a project at https://www.sanity.io/manage, then run `npm run sanity:seed`)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01

# Used only by `npm run sanity:seed`. An Editor token from the project's API settings. Never commit it.
SANITY_API_WRITE_TOKEN=

# Shared secret for the Sanity webhook that calls POST /api/revalidate.
SANITY_REVALIDATE_SECRET=
